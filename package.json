    "type": "module",
    "scripts": {
        "postinstall": "node scripts/setup-hooks.js",
        "dev": "vite",
        "dev:web-only": "vite",
        "lint": "eslint . --max-warnings=0",
        "typecheck": "tsc -b",
        "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "npm run lint && npm run typecheck && npm run test:typecheck && npm run test",
        "ci": "npm run check && npm run build",
        "build": "tsc -b && vite build",
        "build:mcp-adapter": "node scripts/build-mcp-adapter.mjs",
        "preview": "vite preview",
        "tauri": "tauri",
